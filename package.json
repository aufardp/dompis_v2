    "projection:initial": "tsx scripts/projection-initial.ts",
    "projection:incremental": "tsx scripts/projection-incremental.ts",
    "projection:reconcile": "tsx scripts/projection-reconcile.ts",
    "test:projection": "tsx scripts/test-projection.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test:webhook": "tsx scripts/test-webhook.ts",
    "test:phase1": "tsx scripts/test-phase1-security.ts",
    "test:phase3": "tsx scripts/test-phase3-ingestion.ts",
    "test:phase4": "tsx scripts/test-phase4-projection.ts",
    "test:phase7": "tsx scripts/test-phase7-security.ts",
    "test:phase8": "tsx scripts/test-phase8-observability.ts",
    "test:phase9": "tsx scripts/test-phase9-deploy.ts",
    "test:active-refresh": "tsx scripts/test-active-refresh.ts",
    "test:status-refresh": "tsx scripts/test-status-refresh.ts",
    "audit:operational-buckets": "tsx scripts/audit-operational-buckets.ts",
    "test:phase10": "npm run test:phase1 && npm run test:phase3 && npm run test:phase4 && npm run test:phase7 && npm run test:phase8 && npm run test:phase9",
    "bridge:backfill": "tsx scripts/qosmic-bridge-backfill.ts",
    "outbox:cleanup": "tsx scripts/cleanup-tech-events-backlog.ts",
    "outbox:cleanup:dry": "tsx scripts/cleanup-tech-events-backlog.ts --dry-run",
    "outbox:cleanup:fast": "tsx scripts/cleanup-tech-events-backlog.ts --chunk-size 2000 --sleep-ms 25",
    "outbox:cleanup:hygiene": "tsx scripts/cleanup-tech-events-backlog.ts --only-hygiene",
    "dlq:diagnose": "tsx scripts/diagnose-dlq.ts",
    "bridge:dlq-retry": "tsx scripts/bridge-dlq-retry.ts",
    "projection:reset-failed": "tsx scripts/projection-reset-failed.ts",
    "agg:rebuild": "tsx scripts/rebuild-aggregation.ts",
    "bridge:ingest": "tsx scripts/qosmic-bridge-ingest.ts",
    "backup:db": "tsx scripts/backup-db.ts",
    "lint": "eslint ."
