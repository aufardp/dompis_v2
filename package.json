{
  "name": "dompis_v2",
  "version": "2.5.14",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:server": "tsx server.ts",
    "build": "npm run prisma:generate && cross-env NODE_OPTIONS=--max-old-space-size=2048 SKIP_REDIS_CONNECT=true next build && npm run build:workers && bash scripts/postbuild.sh",
    "prisma:generate": "prisma generate",
    "build:workers": "tsc -p tsconfig.workers.json && mkdir -p dist-workers && cp worker-runtime/register-paths.cjs dist-workers/register-paths.cjs",
    "start": "next start -p 3000",
    "start:prod": "NODE_ENV=production tsx server.ts",
    "worker:start": "NODE_ENV=production node -r ./dist-workers/register-paths.cjs dist-workers/worker.js",
    "worker:ops": "NODE_ENV=production node -r ./dist-workers/register-paths.cjs dist-workers/worker.js",
    "worker:ingestion": "NODE_ENV=production node -r ./dist-workers/register-paths.cjs dist-workers/worker-ingestion.js",
    "worker:projection": "NODE_ENV=production node -r ./dist-workers/register-paths.cjs dist-workers/worker-projection.js",
    "worker:active-refresh": "NODE_ENV=production node -r ./dist-workers/register-paths.cjs dist-workers/worker-active-refresh.js",
    "worker:status-refresh": "NODE_ENV=production node -r ./dist-workers/register-paths.cjs dist-workers/worker-status-refresh.js",
    "worker:bridge": "NODE_ENV=production node -r ./dist-workers/register-paths.cjs dist-workers/worker-bridge.js",
    "ingestion:initial": "tsx scripts/ingestion-initial.ts",
    "ingestion:incremental": "tsx scripts/ingestion-incremental.ts",
    "ingestion:recovery": "tsx scripts/ingestion-recovery.ts",
    "ingestion:force-resync": "tsx scripts/ingestion-force-resync.ts",
    "ingestion:reconcile": "tsx scripts/ingestion-reconcile.ts",
