# ===========================================
# Prisma MySQL — pool params
# ===========================================
# PRISMA_CONNECTION_LIMIT is appended to DATABASE_URL by app/libs/prisma.ts
# Keep total pool ≤ MySQL max_connections / number_of_processes
PRISMA_CONNECTION_LIMIT=4
# PRISMA_SLOW_QUERY_MS > 0 enables slow query logging (warning if query exceeds this ms)
PRISMA_SLOW_QUERY_MS=3000
# DATABASE_URL — do NOT include connection_limit/pool_timeout/connect_timeout params
# (they are appended automatically from PRISMA_CONNECTION_LIMIT)
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE?socket_timeout=60"

# ===========================================
# Raw mysql2 pool (legacy) — same DB, separate connection
# ===========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=

# ===========================================
# App
# ===========================================
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
WEB_INSTANCES=1

# ===========================================
# JWT — use long random strings (minimum 64 characters each)
# ===========================================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Session lifetimes — jose format (e.g. 12h, 7d, 30d). Cookie maxAge derives from these.
JWT_ACCESS_EXPIRY=12h
JWT_REFRESH_EXPIRY_SHORT=7d
JWT_REFRESH_EXPIRY_LONG=30d

# ===========================================
# Cron
# ===========================================
CRON_ENABLED=true

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379

# ===========================================
# Tech Events Webhook
# ===========================================
TECH_EVENTS_WEBHOOK_ENABLED=false
TECH_EVENTS_WEBHOOK_URL=
TECH_EVENTS_WEBHOOK_SECRET=
TECH_EVENTS_DISPATCH_BATCH_SIZE=10
AUTO_ASSIGN_CONCURRENCY=3
AUTO_ASSIGN_MAX_TICKETS_PER_RUN=500
AUTO_ASSIGN_EVENT_CONCURRENCY=5

# ===========================================
# Reguler Branch Webhook
# ===========================================
REGULER_WEBHOOK_ENABLED=false
REGULER_WEBHOOK_URL=
REGULER_WEBHOOK_SECRET=

# ===========================================
# Google Sheets
# ===========================================
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ===========================================
# Google Drive (Evidence Files)
# ===========================================
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=

# ===========================================
# External Scrap Database Configuration
# ===========================================
EXTERNAL_DB_HOST=127.0.0.1
EXTERNAL_DB_PORT=3306
EXTERNAL_DB_USER=
EXTERNAL_DB_PASSWORD=
EXTERNAL_DB_NAME=
# Max concurrent connections from this process to external DB (default 5)
EXTERNAL_DB_CONNECTION_LIMIT=2
# Connection timeout for external DB in ms
EXTERNAL_DB_CONNECT_TIMEOUT_MS=10000
EXTERNAL_DB_SCHEMA_CACHE_TTL_MS=300000

# External Table Names (comma-separated)
EXTERNAL_TABLE_NAMES=jatim_tickets,suramadu_tickets,jatengdiy_tickets,balinusra_tickets

# ===========================================
# Cache
# ===========================================
# TTL in seconds for tickets API (default 15)
TICKETS_CACHE_TTL=15
# TTL in seconds for dashboard operations summary (default 30)
DASHBOARD_CACHE_TTL=30
# Max bytes for Redis cache (default 512KB, increase to 1MB if dashboard payloads are large)
CACHE_MAX_BYTES=4194304

# ===========================================
# Export Limits
# ===========================================
DAILY_EXPORT_MAX_ROWS=100000
SEMESTA_EXPORT_MAX_ROWS=100000
TECH_PERFORMANCE_EXPORT_MAX_ROWS=10000

# ===========================================
# Ingestion Worker Settings
# ===========================================
INGESTION_ENABLED=true
# How often to poll external DB (minutes) — production: 2, dev: 5
INGESTION_INTERVAL_MINUTES=1
# Max run duration before abort (minutes)
INGESTION_TIMEOUT_MINUTES=15
# Redis lock TTL (seconds) — must be > TIMEOUT_MINUTES * 60
INGESTION_LOCK_TTL_SECONDS=900
# Rows to fetch per chunk from external DB
INGESTION_CHUNK_SIZE=800
# Rows per batch write to ticket_raw
INGESTION_BATCH_SIZE=500
# Max concurrent table processing (keep 1 — sequential for consistency)
INGESTION_CONCURRENCY=1
# Transient error retry
INGESTION_RETRY_MAX=3
INGESTION_RETRY_BASE_MS=250
# Circuit breaker
INGESTION_MAX_CONSECUTIVE_ERRORS=5
INGESTION_CIRCUIT_RESET_MINUTES=10
INGESTION_RUN_ON_START=true
# Trigger projection via Redis pub/sub after ingestion completes
INGESTION_TRIGGER_PROJECTION=true
# Cursor stale detection: reset cursor if no movement in N hours
INGESTION_CURSOR_STALE_HOURS=24

# ===========================================
# Projection Worker Settings
# ===========================================
PROJECTION_ENABLED=true
# How often to project ticket_raw → ticket (minutes)
PROJECTION_INTERVAL_MINUTES=1
PROJECTION_TIMEOUT_MINUTES=15
PROJECTION_LOCK_TTL_SECONDS=900
# Rows to fetch per batch from ticket_raw
PROJECTION_BATCH_SIZE=300
# Transaction timeout per sub-batch (ms) — reduced from 120s to 30s to prevent lock contention
PROJECTION_TRANSACTION_TIMEOUT_MS=30000
# Max concurrent processing (1 for transactional consistency)
PROJECTION_CONCURRENCY=1
PROJECTION_RETRY_MAX=3
PROJECTION_RETRY_BASE_DELAY_MS=250
PROJECTION_MAX_CONSECUTIVE_ERRORS=5
PROJECTION_CIRCUIT_RESET_MINUTES=10
# Full scan at 2 AM daily — catches missed records; preserves checkpoint + projection_log prevents dupes
PROJECTION_FULL_SCAN_ENABLED=true
PROJECTION_FULL_SCAN_CRON=0 2 * * *
PROJECTION_RUN_ON_START=true
# Cooldown (minutes) before a failed projection row is re-attempted.
# During cooldown the row is skipped so the pipeline is never blocked; it is
# automatically retried after this window elapses.
PROJECTION_FAILED_COOLDOWN_MINUTES=30

# ===========================================
# Active Refresh Worker Settings
# ===========================================
ACTIVE_REFRESH_ENABLED=true
# How often to refresh active tickets (minutes)
ACTIVE_REFRESH_INTERVAL_MINUTES=5
ACTIVE_REFRESH_BATCH_SIZE=50
ACTIVE_REFRESH_MIN_BATCH_SIZE=40
ACTIVE_REFRESH_MAX_BATCH_SIZE=150
ACTIVE_REFRESH_MAX_SCAN_PER_RUN=500
ACTIVE_REFRESH_TIMEOUT_MINUTES=5
ACTIVE_REFRESH_LOCK_TTL_SECONDS=300
# When run < FAST_RUN_THRESHOLD, consider it "fast" (metrics)
ACTIVE_REFRESH_FAST_RUN_THRESHOLD_MS=10000
# When run > SLOW_RUN_THRESHOLD, consider it "slow" (metrics)
ACTIVE_REFRESH_SLOW_RUN_THRESHOLD_MS=60000
ACTIVE_REFRESH_MAX_CONSECUTIVE_ERRORS=5
ACTIVE_REFRESH_CIRCUIT_RESET_MINUTES=10
ACTIVE_REFRESH_RUN_ON_START=true

# ===========================================
# Status Refresh Worker Settings
# ===========================================
STATUS_REFRESH_ENABLED=true
# How often to scan for status changes (minutes) — runs every 1 min in production
STATUS_REFRESH_INTERVAL_MINUTES=1
STATUS_REFRESH_BATCH_SIZE=100
STATUS_REFRESH_MIN_BATCH_SIZE=50
STATUS_REFRESH_MAX_BATCH_SIZE=200
# How often to re-check recently synced tickets (minutes)
STATUS_REFRESH_RECHECK_MINUTES=2
STATUS_REFRESH_TIMEOUT_MINUTES=5
STATUS_REFRESH_LOCK_TTL_SECONDS=300
STATUS_REFRESH_UPDATE_CHUNK_SIZE=25
# Seed batch: how many tickets to scan per seed query
STATUS_REFRESH_SEED_BATCH_SIZE=50
# Seed query timeout (ms) — prevents runaway seed query
STATUS_REFRESH_SEED_TIMEOUT_MS=20000
STATUS_REFRESH_FAST_RUN_THRESHOLD_MS=10000
STATUS_REFRESH_SLOW_RUN_THRESHOLD_MS=60000
STATUS_REFRESH_MAX_CONSECUTIVE_ERRORS=5
STATUS_REFRESH_CIRCUIT_RESET_MINUTES=10
STATUS_REFRESH_RUN_ON_START=true
STATUS_REFRESH_TRIGGER_PROJECTION=true

# ===========================================
# DLQ (Dead Letter Queue) — Redis-based
# ===========================================
# How often ops-worker retries items from DLQ (minutes)
DLQ_RETRY_INTERVAL_MINUTES=5

# ===========================================
# Reconciliation & Health Checks
# ===========================================
# How often ops-worker checks all system health endpoints (minutes)
HEALTH_CHECK_INTERVAL_MINUTES=15
# Enable daily reconciliation between internal DB and external DB (requires INGESTION_ENABLED)
RECONCILIATION_ENABLED=true
# Cron expression for daily reconciliation
RECONCILIATION_CRON=0 6 * * *

# ===========================================
# Log Retention (ops-worker)
# ===========================================
# Days to keep ingestion/status/active-refresh run logs, projection_request,
# ingestion_quarantine, status_refresh_ticket_state, reguler_webhook_outbox, invite_tokens
LOG_RETENTION_DAYS=30
# Days to keep ticket_raw_finalized markers (delete causes idempotent re-finalize)
FINALIZED_RETENTION_DAYS=90
# Minutes of inactivity after which ticket_active_viewers rows are pruned (light sweep)
ACTIVE_VIEWER_STALE_MINUTES=120

# ===========================================
# Notifications (Telegram / Slack)
# ===========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
# Alert header prefix — e.g. "[PROD · dompis-vps]". Falls back to NODE_ENV + os.hostname()
SERVER_NAME=
ALERT_ENV_LABEL=

# ===========================================
# Rate Limiting
# ===========================================
# Default rate limit per window per IP (applied to all mutation endpoints)
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60

# ===========================================
# DB Backup (optional — run via npm run backup:db)
# ===========================================
DB_BACKUP_DIR=/var/backups/dompis

# ===========================================
# Worker Startup Delays (staggered boot — PM2 only)
# Used by ecosystem.config.js, ignored in local dev
# ===========================================
# Ingestion: 0s, Projection: 10s, Status-refresh: 20s, Active-refresh: 30s, Ops: 40s
WORKER_STARTUP_DELAY_MS=0

# ===========================================
# Teknisi UI Flags (web app — NEXT_PUBLIC_* di-bundle saat build)
# ===========================================
# Redesign closing ticket teknisi (Fitur A/C/D/E — PRD-Redesign-Closing-Ticket-Teknisi)
NEXT_PUBLIC_TEKNISI_CLOSING_REDESIGN_ENABLED=true
